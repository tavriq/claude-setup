{
  "permissions": {
    "allow": [
      "Bash(git *:*)"
    ]
  },
  "model": "opus[1m]",
  "effortLevel": "xhigh",
  "autoCompactEnabled": false,
  "switchModelsOnFlag": false,
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/context-warn.sh"
          }
        ]
      }
    ]
  }
}
